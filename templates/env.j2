TZ={{ geome_environment_variables_tz }}

{#
  See: https://github.com/dedicatedcode/reitti/blob/main/README.md#environment-variables
#}

APP_UID={{ geome_uid }}
APP_GID={{ geome_gid }}

POSTGIS_HOST={{ geome_database_hostname }}
POSTGIS_PORT={{ geome_database_port }}
POSTGIS_USER={{ geome_database_username }}
POSTGIS_PASSWORD={{ geome_database_password }}
POSTGIS_DB={{ geome_database_name }}

LOGGING_LEVEL={{ geome_environment_variables_logging_level }}

REDIS_HOST={{ geome_redis_hostname }}
REDIS_PORT={{ geome_redis_port }}
REDIS_USERNAME={{ geome_redis_username }}
REDIS_PASSWORD={{ geome_redis_password }}
REDIS_DATABASE={{ geome_redis_database }}

TILES_CACHE={{ geome_tilecache_scheme }}://{{ geome_tilecache_identifier }}

SERVER_PORT={{ geome_container_http_port }}

{#
  Map bounds — restrict the rendered map to a specific area.
  Consumed by our fork's map-renderer.js (see sgc/apps/geome patches).
  Upstream Reitti does not yet honor these; safe to set regardless.
#}
GEOME_MAP_BOUNDS_SW_LAT={{ geome_map_bounds_sw_lat }}
GEOME_MAP_BOUNDS_SW_LNG={{ geome_map_bounds_sw_lng }}
GEOME_MAP_BOUNDS_NE_LAT={{ geome_map_bounds_ne_lat }}
GEOME_MAP_BOUNDS_NE_LNG={{ geome_map_bounds_ne_lng }}
GEOME_MAP_CENTER_LAT={{ geome_map_center_lat }}
GEOME_MAP_CENTER_LNG={{ geome_map_center_lng }}
GEOME_MAP_MIN_ZOOM={{ geome_map_min_zoom }}
GEOME_MAP_MAX_ZOOM={{ geome_map_max_zoom }}
GEOME_MAP_DEFAULT_ZOOM={{ geome_map_default_zoom }}
GEOME_MAP_BOUNDS_STRICT={{ geome_map_bounds_strict | string | lower }}

{{ geome_environment_variables_additional_variables }}
