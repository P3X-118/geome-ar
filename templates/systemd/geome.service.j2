[Unit]
Description=Geome ({{ geome_identifier }})
{% for service in geome_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in geome_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ sysd_docker_unit_home_path }}"
ExecStartPre={{ sysd_docker_host_sh }} -c '{{ geome_container_cleanup_command | trim | replace("\n", " ") }}'

{#
  Running as root with additional capabilities is required for starting Geome.
#}
ExecStartPre={{ sysd_docker_host_command }} create \
      --rm \
      --name={{ geome_identifier }} \
      --log-driver=none \
      --user=0:0 \
      --network={{ geome_container_network }} \
      {% if geome_container_http_host_bind_port %}
      -p {{ geome_container_http_host_bind_port }}:{{ geome_container_http_port }} \
      {% endif %}
      --env-file={{ geome_base_path }}/env \
      --label-file={{ geome_base_path }}/labels \
      --mount type=bind,src={{ geome_data_path }},dst=/data \
      {% for volume in geome_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for arg in geome_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ geome_container_image }}

{% for network in geome_container_additional_networks %}
ExecStartPre={{ sysd_docker_host_command }} network connect {{ network }} {{ geome_identifier }}
{% endfor %}

ExecStart={{ sysd_docker_host_command }} start --attach {{ geome_identifier }}

ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} stop -t {{ sysd_docker_stop_grace }} {{ geome_identifier }} 2>/dev/null || true'
ExecStop=-{{ sysd_docker_host_sh }} -c '{{ sysd_docker_host_command }} rm {{ geome_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ geome_identifier }}

[Install]
WantedBy=multi-user.target
