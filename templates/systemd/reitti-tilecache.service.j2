[Unit]
Description=Reitti tile cache server ({{ reitti_tilecache_identifier }})
{% for service in reitti_tilecache_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
{% for service in reitti_tilecache_systemd_wanted_services_list %}
Wants={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ reitti_tilecache_container_cleanup_command | trim | replace("\n", " ") }}'

ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name={{ reitti_tilecache_identifier }} \
      --log-driver=none \
      --cap-drop=ALL \
      --cap-add=CAP_DAC_OVERRIDE \
      --cap-add=CHOWN \
      --cap-add=SETGID \
      --cap-add=SETUID \
      --network={{ reitti_tilecache_container_network }} \
      {% if reitti_tilecache_container_http_host_bind_port %}
      -p {{ reitti_tilecache_container_http_host_bind_port }}:{{ reitti_tilecache_container_http_port }} \
      {% endif %}
      --env-file={{ reitti_tilecache_base_path }}/env \
      --label-file={{ reitti_tilecache_base_path }}/labels \
      --mount type=bind,src={{ reitti_tilecache_data_path }},dst=/var/cache/nginx \
      {% for volume in reitti_tilecache_container_additional_volumes %}
      --mount type={{ volume.type | default('bind' if '/' in volume.src else 'volume') }},src={{ volume.src }},dst={{ volume.dst }}{{ (',' + volume.options) if volume.options | default('') else '' }} \
      {% endfor %}
      {% for arg in reitti_tilecache_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ reitti_tilecache_container_image }}

{% for network in reitti_tilecache_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ reitti_tilecache_identifier }}
{% endfor %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ reitti_tilecache_identifier }}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} {{ reitti_tilecache_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ reitti_tilecache_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ reitti_tilecache_identifier }}

[Install]
WantedBy=multi-user.target
